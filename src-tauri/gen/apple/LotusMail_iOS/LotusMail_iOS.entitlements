<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Bez tego iOS odmawia dostępu do pęku kluczy: hasła kont i hasło
	     synchronizacji nie mają się gdzie zapisać, a każda operacja kończy się
	     błędem magazynu haseł. Prefiks podstawia zespół z profilu podpisu. -->
	<key>keychain-access-groups</key>
	<array>
		<string>$(AppIdentifierPrefix)com.pachura.mailmanager</string>
	</array>
</dict>
</plist>
