{
  "version": "2.0.0",
  "tasks": [
    {
      // Serwer frontendu. Rdzeń w trybie deweloperskim ładuje interfejs
      // z http://localhost:1420 (devUrl w tauri.conf.json), więc musi
      // działać, zanim wystartuje plik wykonywalny.
      "label": "ui:dev",
      "type": "shell",
      "command": "npm run dev",
      "isBackground": true,
      "problemMatcher": {
        "owner": "vite",
        "pattern": {
          "regexp": "^$",
          "file": 1,
          "location": 2,
          "message": 3
        },
        "background": {
          // Zadanie uchodzi za gotowe, gdy Vite wypisze „ready in" -
          // bez tego debugger ruszyłby, zanim będzie co wyświetlić.
          "activeOnStart": true,
          "beginsPattern": "VITE",
          "endsPattern": "ready in"
        }
      },
      "presentation": { "group": "tauri", "reveal": "silent" }
    },
    {
      // Sam rdzeń, bez uruchamiania. Debugger startuje potem gotową binarkę,
      // dzięki czemu punkty przerwania w Rust działają od pierwszej linii.
      "label": "core:build",
      "type": "shell",
      "command": "cargo build --manifest-path src-tauri/Cargo.toml --no-default-features",
      "problemMatcher": ["$rustc"],
      "presentation": { "group": "tauri", "reveal": "silent" }
    },
    {
      "label": "tauri:debug-prepare",
      "dependsOrder": "sequence",
      "dependsOn": ["ui:dev", "core:build"]
    }
  ]
}
